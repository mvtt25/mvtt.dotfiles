# Modest Dark for btop: Ghostty's palette (~/.config/ghostty/themes/modest-dark).
# Empty main_bg: Ghostty's translucent background shows through.
theme[main_bg]=""
theme[main_fg]="#abb2bf"
theme[title]="#d7dae0"
theme[hi_fg]="#5ab0f6"
theme[selected_bg]="#2c313a"
theme[selected_fg]="#d7dae0"
theme[inactive_fg]="#4f5666"
theme[graph_text]="#abb2bf"
theme[meter_bg]="#2c313a"
theme[proc_misc]="#4dbdcb"

# Box outlines and dividers, quiet.
theme[cpu_box]="#3f4451"
theme[mem_box]="#3f4451"
theme[net_box]="#3f4451"
theme[proc_box]="#3f4451"
theme[div_line]="#3f4451"

# Gradients: start, middle, end.
theme[temp_start]="#8cc265"
theme[temp_mid]="#ebc275"
theme[temp_end]="#ef5f6b"
theme[cpu_start]="#4dbdcb"
theme[cpu_mid]="#5ab0f6"
theme[cpu_end]="#c162de"
theme[free_start]="#4f5666"
theme[free_mid]=""
theme[free_end]="#8cc265"
theme[cached_start]="#4f5666"
theme[cached_mid]=""
theme[cached_end]="#5ab0f6"
theme[available_start]="#4f5666"
theme[available_mid]=""
theme[available_end]="#4dbdcb"
theme[used_start]="#ebc275"
theme[used_mid]=""
theme[used_end]="#ef5f6b"
theme[download_start]="#4dbdcb"
theme[download_mid]="#5ab0f6"
theme[download_end]="#c162de"
theme[upload_start]="#8cc265"
theme[upload_mid]="#ebc275"
theme[upload_end]="#ef5f6b"
theme[process_start]="#4dbdcb"
theme[process_mid]="#5ab0f6"
theme[process_end]="#c162de"
